        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        }
      }
    },
    "booking_status_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance", "confidence", "evidence"],
