        "local_date": {
          "$ref": "#/$defs/text_field"
        },
        "local_time": {
          "$ref": "#/$defs/text_field"
        },
        "precision": {
          "$ref": "#/$defs/time_precision_field"
        },
        "iana_time_zone": {
          "$ref": "#/$defs/text_field"
        },
        "utc_offset": {
