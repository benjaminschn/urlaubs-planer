          "$ref": "#/$defs/location"
        },
        "ticket_numbers": {
          "$ref": "#/$defs/string_list_field"
        },
        "participant_count": {
          "$ref": "#/$defs/integer_field"
        },
        "requirements": {
          "$ref": "#/$defs/string_list_field"
        },
        "included_services": {
          "$ref": "#/$defs/string_list_field"
        },
        "excluded_services": {
          "$ref": "#/$defs/string_list_field"
        }
      }
    },
    "nullable_accommodation_details": {
      "anyOf": [
        {
          "$ref": "#/$defs/accommodation_details"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_flight_details": {
      "anyOf": [
        {
          "$ref": "#/$defs/flight_details"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_train_details": {
      "anyOf": [
        {
          "$ref": "#/$defs/train_details"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_generic_details": {
      "anyOf": [
        {
          "$ref": "#/$defs/generic_details"
        },
        {
          "type": "null"
        }
      ]
    },
    "typed_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accommodation", "flight", "train", "generic"],
      "properties": {
        "accommodation": {
          "$ref": "#/$defs/nullable_accommodation_details"
        },
        "flight": {
          "$ref": "#/$defs/nullable_flight_details"
        },
        "train": {
          "$ref": "#/$defs/nullable_train_details"
        },
        "generic": {
          "$ref": "#/$defs/nullable_generic_details"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_index",
        "event_type",
        "title",
        "booking_status",
        "start",
        "end",
        "main_location",
        "start_location",
        "end_location",
        "provider_name",
        "booking_platform_name",
        "booking_references",
        "travelers",
        "provider_contacts",
        "management_url",
        "pricing",
        "booking_date",
        "cancellation_deadline",
        "cancellation_conditions",
        "notes",
        "additional_attributes",
        "details"
      ],
      "properties": {
        "event_index": {
          "type": "integer",
          "minimum": 0
        },
        "event_type": {
          "$ref": "#/$defs/event_type_field"
        },
        "title": {
          "$ref": "#/$defs/text_field"
        },
        "booking_status": {
          "$ref": "#/$defs/booking_status_field"
        },
        "start": {
          "$ref": "#/$defs/local_time_value"
        },
        "end": {
          "$ref": "#/$defs/local_time_value"
        },
        "main_location": {
          "$ref": "#/$defs/location"
        },
        "start_location": {
          "$ref": "#/$defs/location"
        },
        "end_location": {
          "$ref": "#/$defs/location"
        },
        "provider_name": {
          "$ref": "#/$defs/text_field"
        },
        "booking_platform_name": {
          "$ref": "#/$defs/text_field"
        },
        "booking_references": {
          "$ref": "#/$defs/references_field"
        },
        "travelers": {
          "$ref": "#/$defs/string_list_field"
        },
        "provider_contacts": {
          "$ref": "#/$defs/contacts_field"
        },
        "management_url": {
          "$ref": "#/$defs/text_field"
        },
        "pricing": {
          "$ref": "#/$defs/pricing"
        },
        "booking_date": {
          "$ref": "#/$defs/text_field"
        },
        "cancellation_deadline": {
          "$ref": "#/$defs/local_time_value"
        },
        "cancellation_conditions": {
          "$ref": "#/$defs/text_field"
        },
        "notes": {
          "$ref": "#/$defs/text_field"
        },
        "additional_attributes": {
          "$ref": "#/$defs/attributes_field"
        },
        "details": {
          "$ref": "#/$defs/typed_details"
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "event_index", "field_path", "message", "evidence"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "conflicting_information",
            "ambiguous_information",
            "missing_critical_information",
            "timezone_unresolved",
            "chronology_unresolved",
            "unsupported_event_kind",
            "possible_duplicate",
            "other"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["info", "review", "blocking"]
        },
        "event_index": {
          "type": ["integer", "null"]
        },
        "field_path": {
          "type": ["string", "null"],
          "maxLength": 250
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        }
      }
    }
  }
}
