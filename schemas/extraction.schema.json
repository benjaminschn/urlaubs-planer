{
  "title": "Travel document LLM extraction output",
  "description": "Strict, versioned contract for the LLM response only. This is not a database or TravelItem schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result",
    "document_summary",
    "events",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "result": {
      "type": "string",
      "enum": ["completed", "partial", "no_relevant_events"]
    },
    "document_summary": {
      "$ref": "#/$defs/text_field"
    },
    "events": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "string",
      "enum": ["explicit", "inferred", "unknown"]
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_number", "source_hint"],
      "properties": {
        "page_number": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "source_hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "evidence_list": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "text_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance", "confidence", "evidence"],
      "properties": {
        "value": {
          "type": ["string", "null"],
          "maxLength": 2000
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        }
      }
    },
    "integer_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance", "confidence", "evidence"],
      "properties": {
        "value": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        }
      }
    },
    "boolean_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance", "confidence", "evidence"],
      "properties": {
        "value": {
          "type": ["boolean", "null"]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        }
      }
    },
    "string_list_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance", "confidence", "evidence"],
      "properties": {
        "value": {
          "type": ["array", "null"],
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        }
      }
    },
    "event_type_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance", "confidence", "evidence"],
      "properties": {
        "value": {
          "type": ["string", "null"],
