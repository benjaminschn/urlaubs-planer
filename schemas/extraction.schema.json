        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        }
      }
    },
    "time_precision_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance", "confidence", "evidence"],
      "properties": {
        "value": {
          "type": ["string", "null"],
          "enum": ["exact_time", "date_only", "unknown_time", null]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        }
      }
    },
    "time_resolution_field": {
      "type": "object",
